{
  "info": {
    "name": "AI Crypto Insight API",
    "description": "Token Insight & Analytics API - DappLooker Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Token Insight - Bitcoin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/token/bitcoin/insight",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vs_currency\": \"usd\",\n  \"history_days\": 30\n}"
        }
      }
    },
    {
      "name": "Token Insight - Chainlink",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/token/chainlink/insight",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "Token Insight - Ethereum (with history)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/token/ethereum/insight",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vs_currency\": \"usd\",\n  \"history_days\": 7\n}"
        }
      }
    },
    {
      "name": "Token Insight - Invalid Token (404)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/token/this-token-does-not-exist/insight"
      }
    },
    {
      "name": "HyperLiquid PnL - Sample Wallet",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/hyperliquid/0xE7bAC70aDA3a5AeF1e1a1fBe68D3dDfcFc18E892/pnl?start=2025-08-01&end=2025-08-03",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hyperliquid", "0xE7bAC70aDA3a5AeF1e1a1fBe68D3dDfcFc18E892", "pnl"],
          "query": [
            { "key": "start", "value": "2025-08-01" },
            { "key": "end", "value": "2025-08-03" }
          ]
        }
      }
    },
    {
      "name": "HyperLiquid PnL - Invalid Wallet (400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/hyperliquid/invalid-wallet/pnl?start=2025-08-01&end=2025-08-03",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hyperliquid", "invalid-wallet", "pnl"],
          "query": [
            { "key": "start", "value": "2025-08-01" },
            { "key": "end", "value": "2025-08-03" }
          ]
        }
      }
    }
  ]
}
